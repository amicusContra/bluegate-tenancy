# Copy to .env and fill in keys as you obtain them
# All keys are optional — sources that need a key will skip gracefully

# === API Keys ===

# OpenCorporates (free tier requires key now; apply at opencorporates.com/api_accounts/new)
OPENCORPORATES_API_KEY=

# PubRecords production key (dev key used by default; upgrade at pubrecords.com)
PUBRECORDS_API_KEY=

# CourtListener (free API, key raises rate limits; apply at courtlistener.com/sign-in/)
COURTLISTENER_API_KEY=

# SerpAPI (for Google-indexed results scraping)
SERPAPI_KEY=

# === Scraping Proxies (for Cloudflare bypass) ===

# ScrapingAnt (scrapingant.com — JS rendering + proxy)
SCRAPINGANT_API_KEY=

# ScrapFly (scrapfly.io — JS rendering + proxy)
SCRAPFLY_API_KEY=

# === Notes ===
# ProPublica (no key needed - free public API)
# IRS TEOS (no key needed - free, but often requires browser automation)
# LARA MiBusiness (no key - uses Playwright browser automation)
# State Bar MI (no key - uses Playwright browser automation)
# BS&A Property (no key - uses Playwright browser automation)
# MDE Educator Lookup (no key - uses Playwright browser automation)
# MI Campaign Finance Local (no key - downloads bulk CSVs from MI SOS)

